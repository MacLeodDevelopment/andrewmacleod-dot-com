---
title: 'Hello! <br /> I am Andrew MacLeod <span class="sr-only">of the Clan MacLeod.</span>'
subtitle: and I am a Software Engineer.
layout: layout.njk
---

<section id="experience">
    <h2>Experience</h2>

    <p>
        I currently work as Principal Engineer for a property-tech company in London.<br />
        Below are some of the things I've done in my previous roles. <br />
        You can also read more about me on 
        <a href="https://www.linkedin.com/in/andrewmacleodnottingham"
            target="_blank"
            rel="noopener"
            title="Andrew MacLeod LinkedIn Profile"
            >LinkedIn <span class="sr-only">(opens in a new tab)</span>
        </a>.
    </p>

    <div class="experience">
        {% for experience in collections.experience | sort(attribute="data.order") %}

        <div class="experience-card">
            <h3><a href="{{ experience.url }}">{{ experience.data.linkFriendlyTitle }}</a></h3>
            <p>
                {{ experience.data.intro }}
            </p>
        </div>

        {% endfor %}
    </div>
</section>

<section id="about" class="about">
    <h2>About Me</h2>
    <p>I like to cook, read, and play retro computer games.</p>
</section>

<section id="contact" class="contact">
    <h2>Contact</h2>

    <p>
        Feel free to get in touch.
    </p>

    <form id="contact-form">

        <label for="email">
            Your email
        </label>

        <input
            id="email"
            name="email"
            type="email"
            required />

        <label for="message">
            Message
        </label>

        <textarea
            id="message"
            name="message"
            rows="6"
            required></textarea>

        <div id="turnstile"></div>

        <button type="submit">
            Send
        </button>

    </form>

    <p id="contact-status" aria-live="polite"></p>

    <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer>
    </script>

    <script>
let turnstileToken = "";

window.onload = () => {

    turnstile.render("#turnstile", {
        sitekey: "YOUR_SITE_KEY",

        callback(token) {
            turnstileToken = token;
        }
    });

    document
        .getElementById("contact-form")
        .addEventListener("submit", async (e) => {

            e.preventDefault();

            const form = e.target;
            const status = document.getElementById("contact-status");

            status.textContent = "Sending...";

            try {

                const response = await fetch(
                    "https://YOUR_WORKER.workers.dev",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            email: form.email.value,
                            message: form.message.value,
                            token: turnstileToken
                        })
                    });

                if (response.ok) {
                    status.textContent = "Message sent successfully.";

                    form.reset();
                    turnstile.reset();
                    turnstileToken = "";
                }
                else {
                    status.textContent = await response.text();
                }

            }
            catch (err) {

                console.error(err);
                status.textContent = "Network error.";

            }

        });

};
</script>

</section>

