<script>
    // Show which address was asked for. textContent, never innerHTML: the path comes from the URL.
    // decodeURI throws on a malformed address (such as a stray %), so fall back to it as typed.
    let requested = location.pathname;
    try { requested = decodeURI(requested); } catch { }
    document.getElementById('requested-path').textContent = requested;
</script>
