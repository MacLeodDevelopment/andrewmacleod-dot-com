<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ metaTitle or "Andrew MacLeod - Consultant Software Engineer" }}</title>
  <meta name="description" content="{{ metaDescription or 'Portfolio website for Andrew MacLeod' }}" />

  <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/martian-mono-latin.woff2" as="font" type="font/woff2" crossorigin>

  <link rel="preload" href="/styles/main.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="/styles/main.css">
  </noscript>

  {% if lightbox %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/css/glightbox.min.css" />
  {% endif %}

  <!-- Minimal critical styles only: colours and the sizes that would otherwise shift when main.css loads -->
  <style>
    :root { color-scheme: light dark; }
    body { margin: 0; background: #e8e8e4; color: #111; }
    @media (prefers-color-scheme: dark) { body { background: #0e0e0e; color: #ececea; } }

    /* Header: reserve its height */
    .site-header .bar { display: flex; justify-content: space-between; align-items: stretch; height: 52px; }

    /* Inner-page title block: reserve the photo's size */
    .page-head { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; align-items: center; }
    .page-head .frame { width: clamp(72px, 12vw, 112px); aspect-ratio: 1; }

    /* Home title block: square photo */
    .r-title .frame { aspect-ratio: 1; }

    /* Reserve width for the year */
    #year { display: inline-block; min-width: 4ch; }
  </style>
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap bar">
      <a class="home-link" href="{{ '/' | url }}"><i aria-hidden="true"></i>Andrew MacLeod</a>

      <!-- Desktop nav: hidden at 640px and below -->
      <nav class="nav-desktop" aria-label="Main navigation">
        <ul>
          <li><a href="{{ '/' | url }}#experience">Experience</a></li>
          <li><a href="{{ '/' | url }}#about">About</a></li>
          <li><a href="{{ '/interests/' | url }}">Interests</a></li>
          <li><a href="{{ '/' | url }}#contact">Contact</a></li>
        </ul>
      </nav>

      <!-- Mobile-only JS-free menu: shown at 640px and below -->
      <details class="nav-mobile">
        <summary aria-controls="nav-list-mobile">
          <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false">
            <line class="line line1" x1="0" y1="2" x2="14" y2="2"></line>
            <line class="line line2" x1="0" y1="7" x2="14" y2="7"></line>
            <line class="line line3" x1="0" y1="12" x2="14" y2="12"></line>
          </svg>
          Menu
        </summary>
        <nav aria-label="Main navigation">
          <ul id="nav-list-mobile">
            <li><a href="/#experience">Experience</a></li>
            <li><a href="/#about">About</a></li>
            <li><a href="/interests/">Interests</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </header>

  <main id="main" class="wrap">
    {% if homePage %}

    {{ content | safe }}

    {% else %}

    <div class="sheet">
      <div class="row">
        <div class="page-head">
          <div class="frame">
            <img src="/images/andrew-macleod-profile-256.jpg"
              srcset="/images/andrew-macleod-profile-128.jpg 128w, /images/andrew-macleod-profile-256.jpg 256w"
              sizes="112px" alt="Andrew MacLeod" width="112" height="112">
          </div>
          <div>
            <p class="m">{% if rev %}Experience · Rev {{ rev }}{% else %}{{ label or "Datasheet" }}{% endif %}</p>
            <h1>{{ (title or "Andrew MacLeod") | safe }}</h1>
            {% if subtitle %}<p class="sub">{{ subtitle }}</p>{% endif %}
          </div>
        </div>
      </div>

      {{ content | safe }}
    </div>

    {% endif %}
  </main>

  <footer class="wrap site-footer m">
    <span>© <span id="year"></span> Andrew MacLeod. All rights reserved.</span>
    <span>Document AM-DS-001 · Specifications subject to change</span>
  </footer>

  <script>
    const year = new Date().getFullYear();
    document.getElementById('year').textContent = year;
    document.querySelectorAll('.js-year').forEach(el => el.textContent = year);
  </script>

  <script>
  // Close the mobile menu after a link is chosen.
  // Smooth scrolling to anchors is handled by scroll-behavior in main.css.
  document.querySelectorAll('.nav-mobile ul a').forEach(link => {
    link.addEventListener('click', () => {
      const details = link.closest('.nav-mobile');
      if (details) details.removeAttribute('open');
    });
  });
  </script>

</body>

</html>
